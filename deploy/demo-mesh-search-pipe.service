# demo-mesh-search: wire.ws-door /wire pipe (library) with ?at=<peer>, until the node's ws-door is updated; ~/dev/demo-mesh-search
[Unit]
Description=demo-mesh-search ws-pipe (/wire on 127.0.0.1:7794)
After=ce-door.service

[Service]
ExecStart=%h/.local/share/ce/cells/ws-pipe-0.1.0 127.0.0.1:7794
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
